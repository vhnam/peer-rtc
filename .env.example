# Vite+ TLS/CA: mkcert leaf + local CA
# https://viteplus.dev/guide/installer-env-vars#tls-ca-configuration
SSL_CERT_FILE=.cert/cert.pem
SSL_KEY_FILE=.cert/key.pem
# Optional. Defaults to `mkcert -CAROOT`/rootCA.pem when unset.
# NODE_EXTRA_CA_CERTS=

# Public origin (must be prefixed with VITE_ for the client)
VITE_PUBLIC_APP_URL=https://localhost:3000
